# Copy to .env and fill in. .env is gitignored; never commit a real key.
#
# These are read by the speech proxy, which runs in Node. They are NOT
# prefixed with VITE_, which is deliberate: Vite only exposes VITE_ variables
# to the browser bundle, so a key here cannot leak into client-side
# JavaScript. Do not rename them to VITE_ANYTHING.

# --- Deepgram -----------------------------------------------------------------
# https://console.deepgram.com -> API Keys
DEEPGRAM_API_KEY=

# British male Aura voice; the same one the Voice Agent config uses.
# Other options include aura-2-draco-en (British) and aura-asteria-en (US).
DEEPGRAM_TTS_MODEL=aura-helios-en

# Leave unset in normal use. Pointing this at a local stub is how the speech
# chain is tested without a key: see ./scripts/preview.sh --stub-tts
# DEEPGRAM_BASE_URL=https://api.deepgram.com

# Pin the audio format if you need a specific container. Unset lets Deepgram
# choose and lets the browser's decoder work it out, which is more robust.
# DEEPGRAM_TTS_ENCODING=linear16
# DEEPGRAM_TTS_CONTAINER=wav

# --- ElevenLabs (the slot) ----------------------------------------------------
# Both are needed before the provider reports itself as available.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
